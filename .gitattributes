# Normalize line endings for text files on checkout/commit.
# Pair with local core.autocrlf (see README "Git line endings").
* text=auto

# Shell scripts always use LF in the repo.
*.sh text eol=lf

# Binary assets — do not alter line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
