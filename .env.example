# --- Local dev (Next.js): copy to `.env.local` ---
# --- Docker Compose: run `npm run env:docker` to copy `.env.local` → `.env`, or create `.env` manually ---

# --- LLM for inspection (MyGenAssist or OpenAI-compatible) ---
# Preferred: MyGenAssist personal API key from your tenant (see internal myGenAssist developer docs).
MYGENASSIST_API_KEY=
# Corporate proxy (if Node cannot reach chat.int.bayer.com directly). Also reads HTTPS_PROXY / HTTP_PROXY.
# MYGENASSIST_HTTPS_PROXY=http://proxy.yourcompany.com:8080
# Optional: hosts that should NOT use the proxy (comma-separated, same as NO_PROXY)
# NO_PROXY=localhost,127.0.0.1
# Optional: corporate TLS inspection root CA (full path to .pem)
# NODE_EXTRA_CA_CERTS=C:/path/to/corporate-root.pem

# OpenAI-compatible base URL: the client calls {baseURL}/chat/completions (do not include /chat/completions twice).
# Bayer myGenAssist example (API root only):
# MYGENASSIST_API_BASE_URL=https://chat.int.bayer.com/api/v2
# You can also paste the full URL from internal docs; /chat/completions is stripped if present:
# MYGENASSIST_API_BASE_URL=https://chat.int.bayer.com/api/v2/chat/completions
# Other gateways often use https://<host>/v1 — if you set only https://<host>, this app appends /v1 automatically.
MYGENASSIST_API_BASE_URL=
# Deployment / model name from myGenAssist docs (required for Bayer gateway; gpt-4o often fails).
# MYGENASSIST_MODEL=
# Optional: LLM request timeout in ms (default 120000). Requires VPN/network access to the gateway host.
# INSPECT_LLM_TIMEOUT_MS=120000

# Alternative key name (still supported): same as MYGENASSIST_API_KEY or a standard OpenAI key.
OPENAI_API_KEY=
# Optional: same as MYGENASSIST_API_BASE_URL for LiteLLM, Azure OpenAI-style proxies, etc.
# OPENAI_BASE_URL=
# Optional alias for MYGENASSIST_MODEL:
# INSPECT_LLM_MODEL=gpt-4o

# Smartsheet form opened from the results panel (pre-filled query params when possible)
SMARTSHEET_FORM_URL=

# Optional: map query parameter names to your Smartsheet form field names (JSON).
# Example: {"inspectionId":"Inspection ID","passFail":"Result","summary":"Issue summary","productProfile":"SKU","timestamp":"When","inspectionContext":"Checklist notes"}
SMARTSHEET_PREFILL_KEYS_JSON=

# --- Backend API security (monorepo split) ---
# Optional: require callers to send this key as Authorization: Bearer <key> or X-API-Key.
# When unset, the backend skips auth checks (convenient for local dev).
# The Next.js frontend injects this server-side when proxying /api/inspect (never expose in NEXT_PUBLIC_*).
# When DATABASE_URL is set, this key is also bootstrapped into api_keys if the table is empty.
# BACKEND_API_KEY=
# Comma-separated browser origins allowed by backend CORS (default: http://localhost:3000,http://127.0.0.1:3000).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Next.js dev proxy target for /api/inspect rewrites (default http://127.0.0.1:4000).
# BACKEND_ORIGIN=http://127.0.0.1:4000
# Optional: call backend directly from the browser instead of the /api proxy (requires CORS + auth).
# NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:4000

# --- PostgreSQL (Phase 5: audit logs + API key storage) ---
# When unset, audit logging and DB-backed API keys are disabled; env auth still works as above.
# Local dev with Docker Compose postgres service:
# DATABASE_URL=postgres://inspect:inspect@localhost:5432/conformance_inspection
# Create additional team keys: npm run db:create-key -- --name "Team A"
# DATABASE_URL=

# Optional: rate limit per client IP (in-memory; reset on server restart)
# INSPECT_RATE_LIMIT_WINDOW_MS=60000
# INSPECT_RATE_LIMIT_MAX=30
# Set INSPECT_RATE_LIMIT_MAX=0 to disable rate limiting (not recommended on public hosts).

# This app does not persist product images by default; keep it that way unless you add storage.

# --- Optional: load every PDF from a server-side folder into each inspection (local dev / self-hosted only) ---
# Use a path on the same machine where `next dev` or `next start` runs. PDFs in subfolders are included (recursive scan).
# Example (use forward slashes to avoid .env escape issues with \r):
# SOP_SCAN_DIRECTORY=C:/Users/rkpouc/OneDrive - Bayer/Migrated from My PC/Documents/RDCM/Cursor/SOPs-for-inspection
# SOP_SCAN_MAX_PDFS=40
# (Cap applies after sorting all matching PDF paths; increase if you have many nested files.)
SOP_SCAN_DIRECTORY=

# Optional: reference photos for Sample Bag Counter (Perfect / Marginal / Bad subfolders).
# Loaded once at backend startup; attached to vision requests only when SAMPLE_BAG_FEW_SHOT_IMAGES=true.
# SAMPLE_SEED_REFERENCE_DIRECTORY=C:/Users/rkpouc/OneDrive - Bayer/Migrated from My PC/Documents/RDCM/Cursor/Sample Seed

# Optional: Sample Bag Counter vision settings (separate from INSPECT_* fast-mode caps)
# SAMPLE_BAG_LLM_MAX_TOKENS=8192
# SAMPLE_BAG_IMAGE_DETAIL=high
# SAMPLE_BAG_FEW_SHOT_IMAGES=false
# When true, attach Perfect/Marginal/Bad reference photos from SAMPLE_SEED_REFERENCE_DIRECTORY to each count request.

# Sample Bag Counter — show purple mask / contour debug panel in the UI (browser-only CV path).
# NEXT_PUBLIC_SAMPLE_BAG_DEBUG=true

# Optional: max PDF file size per file for text extraction (MB). Default 20, max 50.
# INSPECT_PDF_MAX_MB=20

# --- Optional: faster inspection (lower latency, slightly reduced fidelity) ---
# INSPECT_FAST_MODE=true
# Enables fast defaults: low-res vision, shorter standards text, fewer LLM tokens, skips arrow refine unless INSPECT_REFINE_OUTLINES=true.
# INSPECT_SKIP_ARROW_REFINE=true
# Skip refineDefectRegions entirely (fastest fail path; arrows only if the initial inspect returns outline data).
# INSPECT_REFINE_OUTLINES=true
# When INSPECT_FAST_MODE=true, set this to keep hand-drawn arrow refinement (extra LLM calls per defect).
# INSPECT_IMAGE_DETAIL=low
# Vision image detail for inspect calls: low | high (default high; fast mode defaults to low unless overridden).
# INSPECT_STANDARDS_MAX_CHARS=6000
# Max characters of combined standards text sent to the model (default 80000; fast mode defaults to 6000).
# INSPECT_LLM_MAX_TOKENS=512
# Cap completion tokens on inspect calls (fast mode defaults to 512 when unset).

# --- Optional: geometric lean/overhang check (second vision call + inch-scale math vs SOP Appearance) ---
# SOP Appearance: ≤2 in overhang on pallet, ≤5 in lean. Uses 54×40 / 40×40 footprints for scale.
# Enabled by default; disabled automatically when INSPECT_FAST_MODE=true unless overridden.
# INSPECT_GEOM_LEAN_ENABLED=true
# INSPECT_SOP_MAX_OVERHANG_IN=2
# INSPECT_SOP_MAX_LEAN_IN=5
